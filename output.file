AST Structure:
[PROGRAM]
  [COMMENT] /**
 * @file demo.c
 * @author aaaa0ggmc (lovelinux@yslwd.eu.org)
 * @brief 简单演示文件
 * @version 5.0
 * @date 2026-09-07
 * 
 * @copyright Copyright (c) 2026
 * 
 */
  [COMMENT] /// 预处理指令 ，保持0缩进
  [PREPROCESS] #include <stdio.h>
  [PREPROCESS] #define MAX_BUFFER 1024
  [PREPROCESS] #define PI 3.14159f
  [PREPROCESS] #define ENABLE_FEATURE 1
  [PREPROCESS] #undef OBSOLETE_FLAG
  [COMMENT] /// 全局变量声明与多变量合并
  [COMMENT] /// int, float, double, char, void, long
  [VAR_DECL] type: int name: g_counter
    init:
      [NUM] 0
  VAR_DECL (multi) type: int name: g_status
    init:
      [NUM] 1
  [VAR_DECL] type: int name: g_buffer [array]
    dims:
      [NUM] 64
  [VAR_DECL] type: float name: g_ratio
    init:
      [NUM] 1.0f
  VAR_DECL (multi) type: float name: g_scale
    init:
      [NUM] 0.1e2
  [VAR_DECL] type: double name: g_epsilon
    init:
      [NUM] 1.5e-4
  [VAR_DECL] type: char name: g_tag
    init:
      [CHAR] "'V'"
  [VAR_DECL] type: long name: g_large
    init:
      [NUM] 100000
  [COMMENT] /// 函数声明
  [FUNC_DECL] DECL int (name: calculate_sum)
    params:
      [VAR_DECL] type: int name: a
      [VAR_DECL] type: int name: b
  [FUNC_DECL] DECL int (name: sum_array)
    params:
      [VAR_DECL] type: int name: arr [array]
        dims:
          [NULL_EXPR]
      [VAR_DECL] type: int name: size
  [FUNC_DECL] DECL void (name: log_message)
    params:
      [VAR_DECL] type: int name: code
      [VAR_DECL] type: float name: val
  [COMMENT] /// 函数定义
  [FUNC_DEF] DEF int (name: process_algorithm)
    params:
      [VAR_DECL] type: int name: base
      [VAR_DECL] type: float name: factor
    body:
      [COMPOUND_STMT]
        [VAR_DECL] type: int name: dec_num
          init:
            [NUM] 42
        [COMMENT] // 十进制整数
        [VAR_DECL] type: int name: hex_num
          init:
            [NUM] 42
        [COMMENT] // 十六进制整数
        [VAR_DECL] type: int name: oct_num
          init:
            [NUM] 42
        [COMMENT] // 八进制整数
        [VAR_DECL] type: int name: bin_num
          init:
            [NUM] 42
        [COMMENT] // 二进制整数
        [VAR_DECL] type: float name: float_val
          init:
            [NUM] 3.14f
        [COMMENT] // 浮点数带单精度后缀
        [VAR_DECL] type: double name: sci_val
          init:
            [NUM] 0.25e3
        [COMMENT] // 科学计数法浮点数
        [VAR_DECL] type: char name: ch
          init:
            [CHAR] "'A'"
        [COMMENT] // 字符常量
        [VAR_DECL] type: char name: newline
          init:
            [CHAR] "'\n'"
        [COMMENT] // 转义字符常量
        [COMMENT] /// 表达式与运算符优先级层级
        [COMMENT] // 算术运算: +, -, *, /, %
        [VAR_DECL] type: int name: math_res
          init:
            [/]
              [PAREN]
                [+]
                  [VAR] dec_num
                  [*]
                    [VAR] hex_num
                    [NUM] 2
              [PAREN]
                [%]
                  [VAR] oct_num
                  [NUM] 10
        [COMMENT] // 位运算: &, ^, |, ~
        [VAR_DECL] type: int name: bit_res
          init:
            [|]
              [PAREN]
                [&]
                  [VAR] dec_num
                  [NUM] 255
              [PAREN]
                [^]
                  [~]
                    [VAR] bin_num
                  [NUM] 1
        [COMMENT] // 关系与判等运算: <, <=, >, >=, ==, !=
        [COMMENT] // 逻辑运算: &&, ||, !
        [VAR_DECL] type: int name: logic_res
          init:
            [&&]
              [&&]
                [!]
                  [PAREN]
                    [<]
                      [VAR] base
                      [NUM] 0
                [PAREN]
                  [||]
                    [>=]
                      [VAR] factor
                      [NUM] 1.0f
                    [==]
                      [VAR] base
                      [NUM] 42
              [PAREN]
                [!=]
                  [VAR] hex_num
                  [VAR] oct_num
        [COMMENT] // 前置与后置自增自减: ++, --
        [EXPR_STMT]
          [PRE_++]
            [VAR] base
        [EXPR_STMT]
          [POST_++]
            [VAR] base
        [EXPR_STMT]
          [PRE_--]
            [VAR] dec_num
        [EXPR_STMT]
          [POST_--]
            [VAR] dec_num
        [COMMENT] // 数组声明、下标运算与函数调用
        [VAR_DECL] type: int name: arr_data [array]
          dims:
            [NUM] 5
          init:
            [INIT_LIST]
              [NUM] 10
              [NUM] 20
              [NUM] 30
              [NUM] 40
              [NUM] 50
        [VAR_DECL] type: int name: item
          init:
            [INDEX]
              [VAR] arr_data
              [NUM] 0
        [VAR_DECL] type: int name: call_res
          init:
            [FUNCALL] calculate_sum()
              args:
                [VAR] base
                [VAR] math_res
        [COMMENT] // 条件语句
        [IF]
          cond:
            [>]
              [VAR] base
              [NUM] 100
          then:
            [COMPOUND_STMT]
              [EXPR_STMT]
                [=]
                  [VAR] base
                  [-]
                    [VAR] base
                    [NUM] 10
          else:
            [IF]
              cond:
                [==]
                  [VAR] base
                  [NUM] 100
              then:
                [COMPOUND_STMT]
                  [EXPR_STMT]
                    [=]
                      [VAR] base
                      [NUM] 0
              else:
                [COMPOUND_STMT]
                  [EXPR_STMT]
                    [=]
                      [VAR] base
                      [+]
                        [VAR] base
                        [NUM] 10
        [COMMENT] // while循环与break
        [WHILE]
          cond:
            [>]
              [VAR] math_res
              [NUM] 0
          body:
            [COMPOUND_STMT]
              [EXPR_STMT]
                [POST_--]
                  [VAR] math_res
              [IF]
                cond:
                  [==]
                    [VAR] math_res
                    [NUM] 5
                then:
                  [COMPOUND_STMT]
                    [BREAK]
        [COMMENT] // do-while循环与continue
        [DO_WHILE]
          cond:
            [<]
              [VAR] base
              [NUM] 20
          body:
            [COMPOUND_STMT]
              [EXPR_STMT]
                [=]
                  [VAR] base
                  [+]
                    [VAR] base
                    [NUM] 1
              [IF]
                cond:
                  [==]
                    [%]
                      [VAR] base
                      [NUM] 2
                    [NUM] 0
                then:
                  [COMPOUND_STMT]
                    [CONTINUE]
        [COMMENT] // for循环
        [FOR]
          init:
            [VAR_DECL] type: int name: idx
              init:
                [NUM] 0
          cond:
            [<]
              [VAR] idx
              [NUM] 10
          inc:
            [PRE_++]
              [VAR] idx
          body:
            [COMPOUND_STMT]
              [EXPR_STMT]
                [=]
                  [VAR] dec_num
                  [+]
                    [VAR] dec_num
                    [VAR] idx
        [COMMENT] // switch控制流
        [SWITCH]
          cond:
            [VAR] dec_num
          body:
            [COMPOUND_STMT]
              [CASE]
                val:
                  [NUM] 1
                [EXPR_STMT]
                  [=]
                    [VAR] base
                    [+]
                      [VAR] base
                      [NUM] 1
              [BREAK]
              [CASE]
                val:
                  [NUM] 2
                [COMPOUND_STMT]
                  [EXPR_STMT]
                    [=]
                      [VAR] base
                      [+]
                        [VAR] base
                        [NUM] 2
                  [BREAK]
              [DEFAULT]
                [COMPOUND_STMT]
                  [EXPR_STMT]
                    [=]
                      [VAR] base
                      [NUM] 0
                  [BREAK]
        [COMMENT] // 多层嵌套代码块与局部预处理指令
        [COMPOUND_STMT]
          [VAR_DECL] type: int name: level1
            init:
              [NUM] 10
          [COMPOUND_STMT]
            [COMMENT] // 这个依据我的习惯(或者说是我以前看过的标准上这么说的，建议预处理指令0缩进)
            [PREPROCESS] #define INNER_THRESHOLD 64
            [VAR_DECL] type: int name: level2
              init:
                [NUM] 20
            [IF]
              cond:
                [>]
                  [VAR] level2
                  [VAR] INNER_THRESHOLD
              then:
                [COMPOUND_STMT]
